# Salin file ini menjadi ".env" lalu isi API key Gemini Anda (opsional).
# Tanpa API key, agen tetap berjalan dalam mode aturan (rule-based) untuk demo.
# Dapatkan key gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=ISI_API_KEY_ANDA
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=9000
AVSEC_AGENT_PORT=8787
